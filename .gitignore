```gitignore
# =========================
# Maven
# =========================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Maven Wrapper
!.mvn/wrapper/maven-wrapper.jar


# =========================
# IntelliJ IDEA
# =========================
.idea/
*.iml
*.iws
*.ipr


# =========================
# Allure Reports
# =========================
allure-results/
allure-report/


# =========================
# Test Reports
# =========================
surefire-reports/
failsafe-reports/


# =========================
# Build / Generated Files
# =========================
build/
dist/

# Keep source build folders if they are ever created
!**/src/main/**/build/
!**/src/test/**/build/


# =========================
# Kotlin
# =========================
.kotlin/


# =========================
# Eclipse
# =========================
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache


# =========================
# NetBeans
# =========================
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/


# =========================
# VS Code
# =========================
.vscode/


# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db
```
